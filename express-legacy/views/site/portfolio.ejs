<%- include('../partials/head', { description: 'Portfolio of ' + site.hero_name }) %>
<body>
<%- include('../partials/header') %>
<main class="container section">
  <h1>Portfolio</h1>
  <p class="lead">Projects I've built and shipped.</p>
  <div class="grid">
    <% projects.forEach(p => { %>
      <a class="card" href="/portfolio/<%= p.slug %>">
        <% if (p.image_url) { %><img src="<%= p.image_url %>" alt="<%= p.title %>" loading="lazy"><% } %>
        <div class="card-body">
          <h3><%= p.title %><% if (p.featured) { %> <span class="badge">Featured</span><% } %></h3>
          <% if (p.stack) { %><p class="muted small"><%= p.stack %></p><% } %>
          <p><%= p.description.slice(0, 140) %></p>
        </div>
      </a>
    <% }) %>
    <% if (!projects.length) { %>
      <p class="muted">No projects yet — check back soon.</p>
    <% } %>
  </div>
  <%- include('../partials/ads', { position: 'sidebar' }) %>
</main>
<%- include('../partials/footer') %>
