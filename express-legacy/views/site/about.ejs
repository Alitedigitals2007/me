<%- include('../partials/head', { description: 'About ' + site.hero_name + ' — bio, education and experience' }) %>
<body>
<%- include('../partials/header') %>
<main class="container section">
  <h1>About me</h1>
  <p class="lead"><%= site.about_bio %></p>

  <% if (education.length) { %>
  <h2>Education</h2>
  <div class="timeline">
    <% education.forEach(e => { %>
      <div class="timeline-item">
        <div class="timeline-meta"><%= e.start_date %><% if (e.end_date) { %> — <%= e.end_date %><% } %></div>
        <h3><%= e.program %></h3>
        <p class="muted"><%= e.institution %></p>
        <% if (e.description) { %><p><%= e.description %></p><% } %>
      </div>
    <% }) %>
  </div>
  <% } %>

  <% if (roles.length) { %>
  <h2>Experience</h2>
  <div class="timeline">
    <% roles.forEach(r => { %>
      <div class="timeline-item">
        <div class="timeline-meta"><%= r.start_date %><% if (r.end_date) { %> — <%= r.end_date %><% } %></div>
        <h3><%= r.title %></h3>
        <p class="muted"><%= r.org %></p>
        <% if (r.description) { %><p><%= r.description %></p><% } %>
      </div>
    <% }) %>
  </div>
  <% } %>

  <%- include('../partials/ads', { position: 'sidebar' }) %>
</main>
<%- include('../partials/footer') %>
