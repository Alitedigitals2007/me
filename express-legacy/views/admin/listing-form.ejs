<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/header') %>
<main class="admin-layout container">
  <%- include('partials/nav') %>
  <div class="admin-content">
    <h1>New listing</h1>
    <form method="POST" action="/admin/marketplace" enctype="multipart/form-data" class="form">
      <label>Title <input name="title" required></label>
      <label>Description <textarea name="description" rows="5"></textarea></label>
      <label>Price (₦) <input name="price" type="number" step="0.01" value="0"></label>
      <label>Image <input type="file" name="image" accept="image/*"></label>
      <label>...or image URL <input name="image_url"></label>
      <label>Contact (email/WhatsApp) <input name="owner_contact"></label>
      <button class="btn btn-primary" type="submit">Create listing</button>
    </form>
  </div>
</main>
<%- include('../partials/footer') %>
