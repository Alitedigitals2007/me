<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/header') %>
<main class="admin-layout container">
  <%- include('partials/nav') %>
  <div class="admin-content">
    <h1><%= post ? 'Edit post' : 'New post' %></h1>
    <form method="POST" action="<%= post ? '/admin/blog/edit/' + post.id : '/admin/blog' %>" enctype="multipart/form-data" class="form">
      <label>Title <input name="title" id="postTitle" value="<%= post ? post.title : '' %>" required></label>
      <label>Excerpt <textarea name="excerpt" rows="2"><%= post ? post.excerpt : '' %></textarea></label>
      <label>Content (HTML ok) <textarea name="content" id="postContent" rows="16"><%= post ? post.content : '' %></textarea></label>
      <label>Tags (comma separated) <input name="tags" value="<%= post ? post.tags : '' %>" placeholder="tech, life, projects"></label>
      <label>Cover image <input type="file" name="cover" accept="image/*"></label>
      <% if (!post || !post.cover_image) { %>
        <label>...or cover image URL <input name="cover_image" value="<%= post ? post.cover_image : '' %>"></label>
      <% } %>
      <div class="form-row">
        <label>Status
          <select name="status">
            <option value="draft" <%= post && post.status === 'draft' ? 'selected' : '' %>>Draft</option>
            <option value="scheduled" <%= post && post.status === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
            <option value="published" <%= post && post.status === 'published' ? 'selected' : '' %>>Published</option>
          </select>
        </label>
        <label>Publish at (local time) <input name="publish_at" type="datetime-local" value="<%= post ? post.publish_at_local : '' %>"></label>
      </div>
      <button class="btn btn-primary" type="submit">Save post</button>
      <button class="btn btn-outline" type="button" id="aiDraftBtn">✨ AI draft</button>
    </form>
    <div id="aiStatus" class="muted small" style="margin-top: 8px"></div>
  </div>
</main>
<%- include('../partials/footer') %>
