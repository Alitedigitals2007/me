<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/header') %>
<main class="admin-layout container">
  <%- include('partials/nav') %>
  <div class="admin-content">
    <h1><%= title %></h1>
    <form method="POST" action="/admin/<%= title %>" class="form">
      <% if (title === 'education') { %>
        <label>Institution <input name="institution" required></label>
        <label>Program <input name="program" required></label>
      <% } else if (title === 'roles') { %>
        <label>Title <input name="title" required></label>
        <label>Organization <input name="org" required></label>
      <% } else { %>
        <label>Course title <input name="title" required></label>
        <label>Description <textarea name="description" rows="3"></textarea></label>
        <label>Link <input name="link"></label>
        <label>Price (₦) <input name="price" type="number" step="0.01" value="0"></label>
        <label class="checkbox"><input type="checkbox" name="is_own_product" checked> This is my own product</label>
      <% } %>
      <label>Start date <input name="start_date" placeholder="2023"></label>
      <label>End date <input name="end_date" placeholder="2025 or 'Present'"></label>
      <label>Description <textarea name="description" rows="3"></textarea></label>
      <label>Order index <input name="order_index" type="number" value="0"></label>
      <button class="btn btn-primary" type="submit">Add</button>
    </form>

    <h2>Existing entries</h2>
    <table class="table">
      <tr><th><%= title === 'education' ? 'Program' : 'Title' %></th><th><%= title === 'education' ? 'Institution' : 'Org' %></th><th>Dates</th><th>Actions</th></tr>
      <% items.forEach(item => { %>
        <tr>
          <td><%= item.program || item.title %></td>
          <td><%= item.institution || item.org %></td>
          <td><%= item.start_date %> — <%= item.end_date %></td>
          <td class="row-actions">
            <details>
              <summary class="btn btn-sm">Edit</summary>
              <form method="POST" action="/admin/<%= title %>/edit/<%= item.id %>" class="form form-inline">
                <% if (title === 'education') { %>
                  <label>Institution <input name="institution" value="<%= item.institution %>"></label>
                  <label>Program <input name="program" value="<%= item.program %>"></label>
                <% } else if (title === 'roles') { %>
                  <label>Title <input name="title" value="<%= item.title %>"></label>
                  <label>Org <input name="org" value="<%= item.org %>"></label>
                <% } else { %>
                  <label>Title <input name="title" value="<%= item.title %>"></label>
                  <label>Link <input name="link" value="<%= item.link %>"></label>
                  <label>Price <input name="price" type="number" step="0.01" value="<%= item.price %>"></label>
                  <label class="checkbox"><input type="checkbox" name="is_own_product" <%= item.is_own_product ? 'checked' : '' %>> Own</label>
                <% } %>
                <label>Start <input name="start_date" value="<%= item.start_date %>"></label>
                <label>End <input name="end_date" value="<%= item.end_date %>"></label>
                <label>Description <textarea name="description" rows="2"><%= item.description %></textarea></label>
                <label>Order <input name="order_index" type="number" value="<%= item.order_index %>"></label>
                <button class="btn btn-sm" type="submit">Save</button>
              </form>
            </details>
            <form method="POST" action="/admin/<%= title %>/delete/<%= item.id %>" onsubmit="return confirm('Delete?')"><button class="btn btn-sm btn-danger">Delete</button></form>
          </td>
        </tr>
      <% }) %>
      <% if (!items.length) { %><tr><td colspan="4" class="muted">Nothing here yet.</td></tr><% } %>
    </table>
  </div>
</main>
<%- include('../partials/footer') %>
