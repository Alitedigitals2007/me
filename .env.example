# Database (Neon)
DATABASE_URL=postgres://user:pass@host/db

# Admin account created by `npm run seed`
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# Session
SESSION_SECRET=random-long-string

# Site URL (used for Paystack callback + sitemap)
SITE_URL=https://your-site.vercel.app

# Paystack (https://dashboard.paystack.com)
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Cloudinary (https://cloudinary.com) — optional; falls back to local /uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram bot (https://t.me/BotFather) — optional
TELEGRAM_BOT_TOKEN=

# Claude API for AI-assisted blog drafts — optional
ANTHROPIC_API_KEY=
